#!/usr/bin/env bash
# the wifi menu's networks from iwd over d-bus, like the eww wifi menu: a
# json line with what iwd knows now, then with scan, a line every 0.5 s
# while iwd scans. signal is dbm * 100, iwd already sorts by it
#   wifi <dev> [scan]
# {"scanning": bool, "networks": [{ssid, type, connected, known, signal}]}
set -u

dev=$1

objects() {
  busctl --json=short call net.connman.iwd / org.freedesktop.DBus.ObjectManager GetManagedObjects
}

# the station of $dev
st=$(objects | jq -r --arg d "$dev" '.data[0] | to_entries[]
  | select(.value["net.connman.iwd.Station"] and .value["net.connman.iwd.Device"].Name.data == $d)
  | .key' | head -n1)

list() {
  if [ -z "$st" ]; then
    printf '{"scanning":false,"networks":[]}\n'
    return
  fi
  jq -nc --argjson objs "$(objects)" \
    --argjson ord "$(busctl --json=short call net.connman.iwd "$st" net.connman.iwd.Station GetOrderedNetworks)" \
    --argjson scanning "$1" '
    $objs.data[0] as $o
    | {scanning: $scanning, networks: [$ord.data[0][] | . as [$path, $sig]
        | $o[$path]["net.connman.iwd.Network"] as $n
        | select($n != null)
        | {
            ssid: $n.Name.data,
            type: $n.Type.data,
            connected: ($n.Connected.data // false),
            known: ($n.KnownNetwork != null),
            signal: $sig
          }]}'
}

if [ "${2:-}" != scan ] || [ -z "$st" ]; then
  list false
  exit
fi

list true
# fails with busy if iwd scans already, that's fine
busctl call net.connman.iwd "$st" net.connman.iwd.Station Scan >/dev/null 2>&1 || true
for _ in $(seq 20); do
  sleep 0.5
  if [ "$(busctl get-property net.connman.iwd "$st" net.connman.iwd.Station Scanning)" = "b false" ]; then
    break
  fi
  list true
done
list false
