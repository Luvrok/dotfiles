set $mod Mod4

font pango:JetBrainsMonoNL NFP 10

set_from_resource $normbg     dwm.normbgcolor     #000000
set_from_resource $normborder dwm.normbordercolor #3c3836
set_from_resource $normfg     dwm.normfgcolor     #ebdbb2
set_from_resource $selbg      dwm.selbgcolor      #000000
set_from_resource $selborder  dwm.selbordercolor  #d65d0e
set_from_resource $selfg      dwm.selfgcolor      #d65d0e
set $urgent #cc241d

# class                 border      bground     text     indicator   child_border
client.focused          $selborder  $selborder  $selfg   $selborder  $selborder
client.focused_inactive $normborder $normbg     $normfg  $normborder $normborder
client.unfocused        $normborder $normbg     $normfg  $normborder $normborder
client.urgent           $urgent     $urgent     $normfg  $urgent     $urgent
client.background       $normbg

default_border pixel 1
default_floating_border pixel 1
hide_edge_borders none

gaps inner 10
gaps outer 0
smart_gaps off

focus_follows_mouse yes
mouse_warping output
focus_on_window_activation smart
focus_wrapping yes

# workspaces

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"

# tabbed = 1, 2, 9
for_window [workspace="^(1|2|9)$"] layout tabbed

assign [class="^librewolf$"]   $ws1
assign [class="^obsidian$"]    $ws2
assign [class="^qBittorrent$"] $ws9
assign [class="^v2rayN$"]      $ws9

for_window [title="^Picture-in-Picture$"] floating enable, sticky enable, resize set 720 400

for_window [class="^Dragon-drop$"] floating enable, move position center
for_window [class="^ffplay$" title="^android-webcam$"] floating enable

for_window [class="^(spterm|spdotfiles|rangerterm)$"] floating enable, resize set 1280 910, move scratchpad, scratchpad show, move position center

# mouse

floating_modifier $mod
tiling_drag modifier
# middle mouse
bindsym --whole-window $mod+button2 floating toggle

# programs

bindsym $mod+p exec --no-startup-id "xkb-switch -s us; pkill -RTMIN+1 i3blocks; rofi-menu"

bindsym $mod+c         exec --no-startup-id rofi-greenclip
bindsym $mod+Shift+t   exec kitty
bindsym $mod+Shift+f   exec --no-startup-id rofi-librewolf
bindsym --release $mod+space exec --no-startup-id pkill -RTMIN+1 i3blocks
bindsym $mod+w         exec --no-startup-id rofi-powermenu
bindsym $mod+Ctrl+w    exec --no-startup-id rofi-wifi
bindsym $mod+b         exec --no-startup-id rofi-bluetooth
bindsym $mod+Shift+w   exec --no-startup-id webcam
bindsym $mod+r         exec --no-startup-id rofi-recording
bindsym $mod+Shift+r   exec --no-startup-id rofi-recording stop
bindsym $mod+u         exec --no-startup-id rofi-pass
bindsym $mod+Ctrl+k    exec --no-startup-id rofi-killer
bindsym $mod+Shift+u   exec --no-startup-id nixos_menu
bindsym $mod+Shift+d   exec --no-startup-id rofi-audio
bindsym $mod+Shift+y   exec --no-startup-id rofi-translate
bindsym $mod+o         exec kitty --class movies -e yazi /media/outer-1
bindsym $mod+Print     exec --no-startup-id ocr

# XF86
bindsym XF86AudioMute         exec --no-startup-id dwm-volume mute
bindsym XF86AudioLowerVolume  exec --no-startup-id dwm-volume down
bindsym XF86AudioRaiseVolume  exec --no-startup-id dwm-volume up
bindsym XF86MonBrightnessUp   exec --no-startup-id dwm-brightness up
bindsym XF86MonBrightnessDown exec --no-startup-id dwm-brightness down
bindsym Print                 exec --no-startup-id flameshot gui --clipboard --accept-on-select

# monitors
bindsym $mod+F7       exec --no-startup-id xrandr --output DisplayPort-0 --left-of DisplayPort-1 --scale 1x1 --mode 2560x1440 --rate 120.00
bindsym $mod+Shift+F7 exec --no-startup-id xrandr --output DisplayPort-0 --off

# scratchpads

bindsym $mod+g exec --no-startup-id "i3-msg -q '[class=^spterm$] scratchpad show' || kitty --class spterm --name spterm --title scratchpad"
bindsym $mod+v exec --no-startup-id "i3-msg -q '[class=^spdotfiles$] scratchpad show' || kitty --class spdotfiles --name spdotfiles --title dotfiles -e sh -c 'cd ~/HOME/infra/dotfiles && nvim'"
bindsym $mod+e exec --no-startup-id "i3-msg -q '[class=^rangerterm$] scratchpad show' || kitty --class rangerterm --name rangerterm --title ranger -e sh -c 'cd && yazi'"

# removescratch to tile
bindsym $mod+Shift+g floating disable
# setscratch: set current window to scratchpad
bindsym $mod+Ctrl+g  floating enable, move scratchpad

# tiling <-> floating
bindsym $mod+semicolon        focus mode_toggle

# hide / showall
bindsym $mod+Ctrl+h move scratchpad
bindsym $mod+Ctrl+s scratchpad show

# windows
bindsym $mod+Shift+b bar mode toggle
bindsym $mod+y       fullscreen toggle

# focusstack / pushstack
bindsym $mod+j       focus next
bindsym $mod+k       focus prev
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up

# setmfact, setcfact
bindsym $mod+h       resize shrink width 5 px or 5 ppt
bindsym $mod+l       resize grow width 5 px or 5 ppt
bindsym $mod+Shift+h resize grow height 5 px or 5 ppt
bindsym $mod+Shift+l resize shrink height 5 px or 5 ppt

# like master window
bindsym $mod+i split h
bindsym $mod+d split v

bindsym $mod+Shift+c kill
bindsym $mod+Tab     workspace back_and_forth

# setlayout: tile / monocle
bindsym $mod+t layout toggle split
bindsym $mod+m layout tabbed

bindsym $mod+Shift+space floating toggle
bindsym $mod+f           move position center
bindsym $mod+s           sticky toggle

# focusmon / tagmon / tagmonstay
bindsym $mod+comma        focus output left
bindsym $mod+period       focus output right
bindsym $mod+Shift+comma  move container to output left
bindsym $mod+Shift+period move container to output right
bindsym $mod+Ctrl+comma   move container to output left, focus output left
bindsym $mod+Ctrl+period  move container to output right, focus output right

# xrdb
bindsym $mod+F5 exec --no-startup-id "xrdb -merge ~/.Xresources && i3-msg reload"

# self_restart / quit
bindsym $mod+Ctrl+Shift+q restart
bindsym $mod+Shift+BackSpace exit

# view / tag / tagswitch

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9

bindsym $mod+Mod1+1 move container to workspace number $ws1, workspace number $ws1
bindsym $mod+Mod1+2 move container to workspace number $ws2, workspace number $ws2
bindsym $mod+Mod1+3 move container to workspace number $ws3, workspace number $ws3
bindsym $mod+Mod1+4 move container to workspace number $ws4, workspace number $ws4
bindsym $mod+Mod1+5 move container to workspace number $ws5, workspace number $ws5
bindsym $mod+Mod1+6 move container to workspace number $ws6, workspace number $ws6
bindsym $mod+Mod1+7 move container to workspace number $ws7, workspace number $ws7
bindsym $mod+Mod1+8 move container to workspace number $ws8, workspace number $ws8
bindsym $mod+Mod1+9 move container to workspace number $ws9, workspace number $ws9

# i3bar + i3blocks
bar {
    status_command exec i3blocks -c /etc/i3blocks.conf
    position top
    font pango:JetBrainsMonoNL NFP 10
    separator_symbol " | "
    tray_output yes
    workspace_buttons yes
    binding_mode_indicator yes

    colors {
        background $normbg
        statusline $normfg
        separator  $normfg

        #                  border  bground text
        focused_workspace  $selbg  $selbg  $selfg
        active_workspace   $normbg $normbg $selfg
        inactive_workspace $normbg $normbg $normfg
        urgent_workspace   $urgent $urgent $normfg
        binding_mode       $urgent $urgent $normfg
    }
}
