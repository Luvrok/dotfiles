set $mod Mod4

include ~/.config/eww/wifi-menu/i3-wifi.conf
include ~/.config/eww/keys-menu/i3-keys.conf

font pango:JetBrainsMonoNL NFP 10

set_from_resource $normbg     dwm.normbgcolor     #000000
set_from_resource $normborder dwm.normbordercolor #3c3836
set_from_resource $normfg     dwm.normfgcolor     #ebdbb2
set_from_resource $selbg      dwm.selbgcolor      #000000
set_from_resource $selborder  dwm.selbordercolor  #d65d0e
set_from_resource $selfg      dwm.selfgcolor      #d65d0e
set $urgent #cc241d

# class                 border      bground     text     indicator   child_border
client.focused          $selborder  $selborder  $selfg   $selborder  $selborder
client.focused_inactive $normborder $normbg     $normfg  $normborder $normborder
client.unfocused        $normborder $normbg     $normfg  $normborder $normborder
client.urgent           $urgent     $urgent     $normfg  $urgent     $urgent
client.background       $normbg

default_border pixel 1
default_floating_border pixel 1
hide_edge_borders smart_no_gaps

gaps inner 10
gaps outer 0
smart_gaps off

focus_follows_mouse yes
mouse_warping output
focus_on_window_activation smart
focus_wrapping workspace

# dwm-like tags: every monitor has its own 1..9 (see i3-ws). primary is
# 1..9, the second one 11..19, both bars show 1..9. pinned workspaces are
# created on their monitor only and go back there when it's plugged in
workspace 1 output primary
workspace 2 output primary
workspace 3 output primary
workspace 4 output primary
workspace 5 output primary
workspace 6 output primary
workspace 7 output primary
workspace 8 output primary
workspace 9 output primary

# second monitor, add other names after a space
workspace 11 output DisplayPort-0
workspace 12 output DisplayPort-0
workspace 13 output DisplayPort-0
workspace 14 output DisplayPort-0
workspace 15 output DisplayPort-0
workspace 16 output DisplayPort-0
workspace 17 output DisplayPort-0
workspace 18 output DisplayPort-0
workspace 19 output DisplayPort-0

# tabbed: tags 1, 2, 9 on both monitors (11, 12, 19 on the second one)
workspace 1 gaps inner 0
workspace 2 gaps inner 0
workspace 9 gaps inner 0
workspace 11 gaps inner 0
workspace 12 gaps inner 0
workspace 19 gaps inner 0
for_window [workspace="^(1|2|9|11|12|19)$"] layout tabbed

assign [class="^librewolf$"]   number 1
assign [class="^obsidian$"]    number 2
assign [class="^qBittorrent$"] number 9
assign [class="^v2rayN$"]      number 9

for_window [title="^Picture-in-Picture$"] floating enable, sticky enable, resize set 720 400
for_window [title="termfilechooser"] floating enable, resize set 1000 700, move position center
for_window [class="^Dragon-drop$"] floating enable, move position center
for_window [class="^ffplay$" title="^android-webcam$"] floating enable

# i3-sp finds scratchpads by these marks, the size is in i3-sp too
for_window [class="^spterm$"]     mark --add _sp_spterm
for_window [class="^spdotfiles$"] mark --add _sp_spdotfiles
for_window [class="^rangerterm$"] mark --add _sp_rangerterm
for_window [class="^(spterm|spdotfiles|rangerterm)$"] floating enable, resize set 1280 910, move position center

# mouse
floating_modifier $mod
tiling_drag modifier
# middle mouse
bindsym --whole-window $mod+button2 floating toggle

# programs

# us for typing in rofi, then back to what it was
bindsym $mod+p exec --no-startup-id "xkb-switch -s us; rofi-menu"

bindsym $mod+c         exec --no-startup-id rofi-greenclip
bindsym $mod+Shift+t   exec --no-startup-id "xkb-switch -s us; kitty"
bindsym $mod+Shift+f   exec --no-startup-id rofi-librewolf
bindsym $mod+w         exec --no-startup-id rofi-powermenu
bindsym $mod+b         exec --no-startup-id rofi-bluetooth
bindsym $mod+Shift+w   exec --no-startup-id webcam
bindsym $mod+r         exec --no-startup-id rofi-recording
bindsym $mod+Shift+r   exec --no-startup-id rofi-recording stop
bindsym $mod+u         exec --no-startup-id rofi-pass
bindsym $mod+Ctrl+k    exec --no-startup-id rofi-killer
bindsym $mod+Shift+u   exec --no-startup-id nixos_menu
bindsym $mod+Shift+d   exec --no-startup-id rofi-audio
bindsym $mod+Shift+y   exec --no-startup-id rofi-translate
bindsym $mod+o         exec kitty --class movies -e yazi /media/outer-1
bindsym $mod+Print     exec --no-startup-id ocr

# XF86
bindsym XF86AudioMute         exec --no-startup-id dwm-volume mute
bindsym XF86AudioLowerVolume  exec --no-startup-id dwm-volume down
bindsym XF86AudioRaiseVolume  exec --no-startup-id dwm-volume up
bindsym XF86MonBrightnessUp   exec --no-startup-id dwm-brightness up
bindsym XF86MonBrightnessDown exec --no-startup-id dwm-brightness down
bindsym Print                 exec --no-startup-id flameshot gui --clipboard --accept-on-select

# monitors
bindsym $mod+F7       exec --no-startup-id xrandr --output DisplayPort-0 --left-of DisplayPort-1 --scale 1x1 --mode 2560x1440 --rate 120.00
bindsym $mod+Shift+F7 exec --no-startup-id xrandr --output DisplayPort-0 --off

# scratchpads
bindsym $mod+g exec --no-startup-id i3-sp toggle spterm kitty --class spterm --name spterm --title scratchpad
bindsym $mod+v exec --no-startup-id i3-sp toggle spdotfiles kitty --class spdotfiles --name spdotfiles --title dotfiles -e sh -c 'cd ~/HOME/infra/dotfiles && nvim'
bindsym $mod+e exec --no-startup-id i3-sp toggle rangerterm kitty --class rangerterm --name rangerterm --title ranger -e sh -c 'cd && yazi'

# setscratch: focused window becomes the $mod+g scratchpad
bindsym $mod+Ctrl+g  exec --no-startup-id i3-sp set spterm
# removescratch: $mod+g scratchpad becomes a normal tile, $mod+g opens a new one
bindsym $mod+Shift+g [con_id="__focused__" con_mark="^_sp_spterm$"] unmark _sp_spterm; floating disable

# hide / showall: per tag, windows come back tiled or floating as they were
bindsym $mod+Ctrl+h  exec --no-startup-id i3-sp hide
bindsym $mod+Ctrl+s  exec --no-startup-id i3-sp showall

# tiling <-> floating
bindsym $mod+semicolon        focus mode_toggle

# windows
bindsym $mod+Shift+b bar mode toggle
bindsym $mod+y       fullscreen toggle

# focusstack / pushstack: one ring per tag, master then the stack top to
# bottom (clockwise), tabs in tab order. j goes clockwise, k back, both wrap
bindsym $mod+j       exec --no-startup-id i3-tile focus next
bindsym $mod+k       exec --no-startup-id i3-tile focus prev
bindsym $mod+Shift+j exec --no-startup-id i3-tile move next
bindsym $mod+Shift+k exec --no-startup-id i3-tile move prev

# setmfact, setcfact
bindsym $mod+l      resize shrink width 5 px or 5 ppt
bindsym $mod+h      resize grow width 5 px or 5 ppt
bindsym $mod+Shift+h resize grow height 5 px or 5 ppt
bindsym $mod+Shift+l resize shrink height 5 px or 5 ppt

# like master window
bindsym $mod+i split h
bindsym $mod+d split v

# any window fades out and hides, then gets closed. if it refuses (unsaved
# stuff), it's back on its tag in 2 s
bindsym $mod+Shift+c exec --no-startup-id i3-sp kill
# previous tag of this monitor, i3's back_and_forth is global
bindsym $mod+Tab     exec --no-startup-id i3-ws back

# setlayout: tile / monocle. monocle flattens master/stack first, else
# it'd tab only the stack
bindsym $mod+t gaps inner current set 10; gaps outer current set 0; layout default; exec --no-startup-id i3-tile fix
bindsym $mod+m gaps inner current set 0;  gaps outer current set 0; exec --no-startup-id i3-tile monocle

bindsym $mod+Shift+space floating toggle
bindsym $mod+f           move position center
bindsym $mod+s           sticky toggle

# focusmon / tagmon / tagmonstay: the window goes to the open tag of the
# next monitor, workspaces stay
bindsym $mod+comma        focus output left
bindsym $mod+period       focus output right
bindsym $mod+Shift+comma  move container to output left, focus output left
bindsym $mod+Shift+period move container to output right, focus output right
bindsym $mod+Ctrl+comma   move container to output left
bindsym $mod+Ctrl+period  move container to output right

# xrdb
bindsym $mod+F5 exec --no-startup-id "xrdb -merge ~/.Xresources && i3-msg reload"

# self_restart / quit
bindsym $mod+Ctrl+Shift+q restart
bindsym $mod+Shift+BackSpace exit

# view / tag / tagswitch, on this monitor

bindsym $mod+1 exec --no-startup-id i3-ws 1
bindsym $mod+2 exec --no-startup-id i3-ws 2
bindsym $mod+3 exec --no-startup-id i3-ws 3
bindsym $mod+4 exec --no-startup-id i3-ws 4
bindsym $mod+5 exec --no-startup-id i3-ws 5
bindsym $mod+6 exec --no-startup-id i3-ws 6
bindsym $mod+7 exec --no-startup-id i3-ws 7
bindsym $mod+8 exec --no-startup-id i3-ws 8
bindsym $mod+9 exec --no-startup-id i3-ws 9

bindsym $mod+Shift+1 exec --no-startup-id i3-ws move 1
bindsym $mod+Shift+2 exec --no-startup-id i3-ws move 2
bindsym $mod+Shift+3 exec --no-startup-id i3-ws move 3
bindsym $mod+Shift+4 exec --no-startup-id i3-ws move 4
bindsym $mod+Shift+5 exec --no-startup-id i3-ws move 5
bindsym $mod+Shift+6 exec --no-startup-id i3-ws move 6
bindsym $mod+Shift+7 exec --no-startup-id i3-ws move 7
bindsym $mod+Shift+8 exec --no-startup-id i3-ws move 8
bindsym $mod+Shift+9 exec --no-startup-id i3-ws move 9

bindsym $mod+Mod1+1 exec --no-startup-id i3-ws follow 1
bindsym $mod+Mod1+2 exec --no-startup-id i3-ws follow 2
bindsym $mod+Mod1+3 exec --no-startup-id i3-ws follow 3
bindsym $mod+Mod1+4 exec --no-startup-id i3-ws follow 4
bindsym $mod+Mod1+5 exec --no-startup-id i3-ws follow 5
bindsym $mod+Mod1+6 exec --no-startup-id i3-ws follow 6
bindsym $mod+Mod1+7 exec --no-startup-id i3-ws follow 7
bindsym $mod+Mod1+8 exec --no-startup-id i3-ws follow 8
bindsym $mod+Mod1+9 exec --no-startup-id i3-ws follow 9

exec_always --no-startup-id eww-launch
# master/stack like dwm tile, floats fullscreen windows (see i3-tile).
# a restart starts a fresh one, it kills the old
exec_always --no-startup-id i3-tile daemon
