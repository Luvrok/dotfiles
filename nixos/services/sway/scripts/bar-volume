# Громкость для бара.
#   bar-volume            — вывести статус
#   bar-volume up | down  — ±2% (если звук не выключен)
#   bar-volume mute       — выключить/включить звук

SINK='@DEFAULT_AUDIO_SINK@'
STEP=2

getvol() {
  wpctl get-volume "$SINK" | awk '{ print int($2 * 100 + 0.5) }'
}

ismuted() {
  [[ $(wpctl get-volume "$SINK") == *MUTED* ]]
}

action="${1:-}"

case "$action" in
  up | down)
    if ! ismuted; then
      v=$(getvol)
      if [ "$action" = up ]; then v=$((v + STEP)); else v=$((v - STEP)); fi
      if [ "$v" -gt 100 ]; then v=100; fi
      if [ "$v" -lt 0 ]; then v=0; fi
      wpctl set-volume "$SINK" "$v%"
    fi
    ;;
  mute)
    wpctl set-mute "$SINK" toggle
    ;;
esac

if ismuted; then
  echo ""
  exit 0
fi

v=$(getvol)
if [ "$v" -gt 40 ]; then
  icon=""
elif [ "$v" -gt 15 ]; then
  icon=""
else
  icon=""
fi

echo "$icon $v%"
