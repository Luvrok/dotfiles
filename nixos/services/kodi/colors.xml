<?xml version="1.0" encoding="UTF-8"?>
<!-- estuary's colors/defaults.xml in quickshell's Theme.qml: the menus' bg,
     gruvbox's fg and its dim, greys where estuary has blue, the orange only
     on what's selected (the watched mark, a picked item). AARRGGBB -->
<colors>
	<!-- the screen: primary.jpg under it, the pattern over it is off. kodi
	     reads 0 as no color at all (the texture as it is), so 01 -->
	<color name="primary_background">FF171717</color>
	<color name="secondary_background">01000000</color>
	<color name="dialog_tint">FF1D1D1D</color>
	<color name="background">FF171717</color>
	<color name="bg_image">FF909090</color>
	<!-- fanart behind the home screen and the lists, dimmed -->
	<color name="bg_overlay">30FFFFFF</color>
	<color name="black">FF000000</color>
	<color name="white">FFEBDBB2</color>
	<color name="grey">FFA89984</color>
	<color name="blue">FF928374</color>
	<color name="red">FFCC241D</color>
	<!-- the focused row, Theme.line a step lighter so it shows on the bg -->
	<color name="button_focus">FF504945</color>
	<color name="button_alt_focus">80504945</color>
	<color name="text_shadow">22000000</color>
	<!-- the frames around posters and lists: none -->
	<color name="border_alpha">01000000</color>
	<color name="disabled">40EBDBB2</color>
	<color name="selected">FFD65D0E</color>
	<color name="invalid">FFCC241D</color>
</colors>
