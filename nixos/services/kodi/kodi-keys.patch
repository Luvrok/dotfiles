diff --git a/xbmc/windowing/wayland/XkbcommonKeymap.cpp b/xbmc/windowing/wayland/XkbcommonKeymap.cpp
index 9ccb013..a27b60c 100644
--- a/xbmc/windowing/wayland/XkbcommonKeymap.cpp
+++ b/xbmc/windowing/wayland/XkbcommonKeymap.cpp
@@ -441,6 +441,14 @@ XBMCKey CXkbcommonKeymap::XBMCKeyForKeysym(xkb_keysym_t sym)
 
 XBMCKey CXkbcommonKeymap::XBMCKeyForKeycode(xkb_keycode_t code) const
 {
+  // the key as the first layout has it (us of "us,ru"), at the level the
+  // modifiers pick: the keymaps go by latin keys and work on any layout.
+  // the character typed is still the active layout's
+  // (UnicodeCodepointForKeycode)
+  const xkb_level_index_t level = xkb_state_key_get_level(m_state.get(), code, 0);
+  const xkb_keysym_t* syms = nullptr;
+  if (xkb_keymap_key_get_syms_by_level(m_keymap.get(), code, 0, level, &syms) == 1)
+    return XBMCKeyForKeysym(syms[0]);
   return XBMCKeyForKeysym(KeysymForKeycode(code));
 }
 
