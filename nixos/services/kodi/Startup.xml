<?xml version="1.0" encoding="UTF-8"?>
<!-- estuary's xml/Startup.xml. the first start hides the home menu's items
     for what's not on /media/outer-1: music, tv, radio, games, pictures,
     weather, favourites. once, the skin settings bring them back -->
<window>
	<onload condition="!Skin.HasSetting(barnard_menu)">Skin.SetBool(HomeMenuNoMusicButton)</onload>
	<onload condition="!Skin.HasSetting(barnard_menu)">Skin.SetBool(HomeMenuNoMusicVideoButton)</onload>
	<onload condition="!Skin.HasSetting(barnard_menu)">Skin.SetBool(HomeMenuNoTVButton)</onload>
	<onload condition="!Skin.HasSetting(barnard_menu)">Skin.SetBool(HomeMenuNoRadioButton)</onload>
	<onload condition="!Skin.HasSetting(barnard_menu)">Skin.SetBool(HomeMenuNoGamesButton)</onload>
	<onload condition="!Skin.HasSetting(barnard_menu)">Skin.SetBool(HomeMenuNoPicturesButton)</onload>
	<onload condition="!Skin.HasSetting(barnard_menu)">Skin.SetBool(HomeMenuNoWeatherButton)</onload>
	<onload condition="!Skin.HasSetting(barnard_menu)">Skin.SetBool(HomeMenuNoFavButton)</onload>
	<onload condition="!Skin.HasSetting(barnard_menu)">Skin.SetBool(barnard_menu)</onload>
	<onload>ReplaceWindow($INFO[System.StartupWindow])</onload>
	<controls />
</window>
