{
  "name": "Movie pipe: Download…",
  "plugin": "plugin.video.moviepipe",
  "priority": 1,
  "is_resolvable": "false",
  "play_movie": "executebuiltin://RunPlugin(plugin://plugin.video.moviepipe/?action=download&type=movie&tmdb={tmdb})",
  "play_episode": "executebuiltin://RunPlugin(plugin://plugin.video.moviepipe/?action=download&type=episode&tmdb={tmdb}&season={season}&episode={episode})"
}
