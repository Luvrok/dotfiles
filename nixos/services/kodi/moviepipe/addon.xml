<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- radarr and sonarr in kodi (../../arr): "Скачать" and "Выбрать раздачу…"
     in the menu (c) of a film or a show that tmdb helper shows, its
     downloads in video add-ons, kodi's library scanned when one is in.
     ../addons.nix builds it -->
<addon id="plugin.video.moviepipe" name="Movie pipe" version="1.0.0" provider-name="barnard">
	<requires>
		<import addon="xbmc.python" version="3.0.1"/>
	</requires>
	<extension point="xbmc.python.pluginsource" library="default.py">
		<provides>video</provides>
	</extension>
	<extension point="xbmc.service" library="service.py"/>
	<!-- a film not in the library, a show, its season or episode, all
	     with their tmdb id: tmdb helper's lists, kodi's tv shows -->
	<extension point="kodi.context.item">
		<menu id="kodi.core.main">
			<item library="context.py" args="download">
				<label>Скачать</label>
				<visible>[String.IsEqual(ListItem.DBType,movie) + String.IsEmpty(ListItem.DBID) + !String.IsEmpty(ListItem.UniqueID(tmdb))] | [String.IsEqual(ListItem.DBType,tvshow) + !String.IsEmpty(ListItem.UniqueID(tmdb))] | [[String.IsEqual(ListItem.DBType,season) | String.IsEqual(ListItem.DBType,episode)] + !String.IsEmpty(ListItem.UniqueID(tvshow.tmdb))]</visible>
			</item>
			<item library="context.py" args="pick">
				<label>Выбрать раздачу…</label>
				<visible>[String.IsEqual(ListItem.DBType,movie) + String.IsEmpty(ListItem.DBID) + !String.IsEmpty(ListItem.UniqueID(tmdb))] | [String.IsEqual(ListItem.DBType,tvshow) + !String.IsEmpty(ListItem.UniqueID(tmdb))] | [[String.IsEqual(ListItem.DBType,season) | String.IsEqual(ListItem.DBType,episode)] + !String.IsEmpty(ListItem.UniqueID(tvshow.tmdb))]</visible>
			</item>
		</menu>
	</extension>
	<extension point="xbmc.addon.metadata">
		<summary lang="en_GB">Radarr and Sonarr downloads</summary>
		<description lang="en_GB">Downloads films and shows through radarr and sonarr, scans them into the library when they're in.</description>
		<platform>all</platform>
	</extension>
</addon>
