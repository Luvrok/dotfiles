<?xml version="1.0" encoding="UTF-8"?>
<!-- 5, discover (../../../../discover.py), a section of majan's home of its
     own: the page header with the chips (films or shows, search, tmdb
     helper's own list) in the bar, the tile in focus on top (majan's hub
     info), two rows at a time under it, the next ones come up as the focus
     goes down. row n is list 20n (majan-moviepipe.xml's MoviePipe_Row), its
     path, name and page in the window's rown.* properties, row the one whose
     tile is on top (it stays when the focus goes up to the chips). 1 what
     downloads, 2..8 tmdb helper's lists. a row with no path, or that came
     back empty, is hidden; up and down skip it -->
<window>
	<defaultcontrol>101</defaultcontrol>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>Majan_Background</include>
		<include content="Majan_PageHeader">
			<param name="index" value="05"/>
			<param name="title" value="Discover"/>
		</include>
		<include>Majan_Clock</include>
		<include>Majan_TopRule</include>
		<!-- the rows' pages: 4n the next of row n, 5n the one before -->
		<include content="MoviePipe_Click"><param name="id" value="41"/></include>
		<include content="MoviePipe_Click"><param name="id" value="42"/></include>
		<include content="MoviePipe_Click"><param name="id" value="43"/></include>
		<include content="MoviePipe_Click"><param name="id" value="44"/></include>
		<include content="MoviePipe_Click"><param name="id" value="45"/></include>
		<include content="MoviePipe_Click"><param name="id" value="46"/></include>
		<include content="MoviePipe_Click"><param name="id" value="47"/></include>
		<include content="MoviePipe_Click"><param name="id" value="48"/></include>
		<include content="MoviePipe_Click"><param name="id" value="51"/></include>
		<include content="MoviePipe_Click"><param name="id" value="52"/></include>
		<include content="MoviePipe_Click"><param name="id" value="53"/></include>
		<include content="MoviePipe_Click"><param name="id" value="54"/></include>
		<include content="MoviePipe_Click"><param name="id" value="55"/></include>
		<include content="MoviePipe_Click"><param name="id" value="56"/></include>
		<include content="MoviePipe_Click"><param name="id" value="57"/></include>
		<include content="MoviePipe_Click"><param name="id" value="58"/></include>
		<control type="grouplist" id="9000">
			<left>520</left>
			<top>56</top>
			<width>820</width>
			<height>subnav_h</height>
			<orientation>horizontal</orientation>
			<usecontrolcoords>true</usecontrolcoords>
			<itemgap>12</itemgap>
			<onleft>noop</onleft>
			<onright>noop</onright>
			<include content="MoviePipe_Chip">
				<param name="id" value="101"/>
				<param name="label" value="MOVIES"/>
				<param name="shown" value="String.IsEqual(Window.Property(mode),movie)"/>
				<param name="onup" value="noop"/>
				<param name="ondown" value="9100"/>
			</include>
			<include content="MoviePipe_Chip">
				<param name="id" value="102"/>
				<param name="label" value="TV SHOWS"/>
				<param name="shown" value="String.IsEqual(Window.Property(mode),tv)"/>
				<param name="onup" value="noop"/>
				<param name="ondown" value="9100"/>
			</include>
			<include content="MoviePipe_Chip">
				<param name="id" value="103"/>
				<param name="label" value="SEARCH$INFO[Window.Property(query), ,]"/>
				<param name="shown" value="String.IsEqual(Window.Property(mode),search)"/>
				<param name="left" value="24"/>
				<param name="onup" value="noop"/>
				<param name="ondown" value="9100"/>
			</include>
			<include content="MoviePipe_Chip">
				<param name="id" value="104"/>
				<param name="label" value="ALL OF TMDB HELPER"/>
				<param name="shown" value="false"/>
				<param name="left" value="24"/>
				<param name="onup" value="noop"/>
				<param name="ondown" value="9100"/>
			</include>
		</control>
		<include content="MoviePipe_DiscoverInfo"><param name="n" value="1"/></include>
		<include content="MoviePipe_DiscoverInfo"><param name="n" value="2"/></include>
		<include content="MoviePipe_DiscoverInfo"><param name="n" value="3"/></include>
		<include content="MoviePipe_DiscoverInfo"><param name="n" value="4"/></include>
		<include content="MoviePipe_DiscoverInfo"><param name="n" value="5"/></include>
		<include content="MoviePipe_DiscoverInfo"><param name="n" value="6"/></include>
		<include content="MoviePipe_DiscoverInfo"><param name="n" value="7"/></include>
		<include content="MoviePipe_DiscoverInfo"><param name="n" value="8"/></include>
		<!-- the plot on top in focus: up from the rows, enter its whole text
		     (discover.py) -->
		<include content="MoviePipe_PlotButton">
			<param name="id" value="9100"/>
			<param name="width" value="1200"/>
			<param name="height" value="132"/>
			<param name="onup" value="9000"/>
			<param name="ondown" value="300"/>
			<param name="onclick" value="SetFocus(9100)"/>
		</include>
		<control type="label">
			<right>page_margin</right>
			<top>530</top>
			<width>1300</width>
			<height>20</height>
			<align>right</align>
			<font>mono_13</font>
			<textcolor>$VAR[ColorCaption]</textcolor>
			<label>ENTER — DOWNLOAD · A SHOW, A PERSON: THEIR PAGE    I — INFO    C — MENU    T — TRAILER    O — IN THE BROWSER    R — RELOAD</label>
		</control>
		<!-- two rows, whole: a grouplist scrolls by the focused one's height,
		     its own a multiple of it, so no row is ever cut. from the left
		     edge: the first tile's focus frame isn't clipped -->
		<control type="grouplist" id="300">
			<left>0</left>
			<top>572</top>
			<width>screen_w</width>
			<height>508</height>
			<orientation>vertical</orientation>
			<itemgap>0</itemgap>
			<onup>9100</onup>
			<include content="MoviePipe_DiscoverRow"><param name="n" value="1"/><param name="onup" value="9100"/><param name="ondown" value="202"/></include>
			<include content="MoviePipe_DiscoverRow"><param name="n" value="2"/><param name="onup" value="201"/><param name="ondown" value="203"/></include>
			<include content="MoviePipe_DiscoverRow"><param name="n" value="3"/><param name="onup" value="202"/><param name="ondown" value="204"/></include>
			<include content="MoviePipe_DiscoverRow"><param name="n" value="4"/><param name="onup" value="203"/><param name="ondown" value="205"/></include>
			<include content="MoviePipe_DiscoverRow"><param name="n" value="5"/><param name="onup" value="204"/><param name="ondown" value="206"/></include>
			<include content="MoviePipe_DiscoverRow"><param name="n" value="6"/><param name="onup" value="205"/><param name="ondown" value="207"/></include>
			<include content="MoviePipe_DiscoverRow"><param name="n" value="7"/><param name="onup" value="206"/><param name="ondown" value="208"/></include>
			<include content="MoviePipe_DiscoverRow"><param name="n" value="8"/><param name="onup" value="207"/><param name="ondown" value="noop"/></include>
		</control>
	</controls>
</window>
