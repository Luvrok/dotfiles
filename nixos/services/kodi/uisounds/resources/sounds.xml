<?xml version="1.0" encoding="UTF-8"?>
<!-- kodi's actions (kodi.wiki/view/Keymap) and windows
     (kodi.wiki/view/Window_IDs) to the psp's sounds, wav only -->
<sounds>
	<actions>
		<action><name>left</name><file>snd_cursor.wav</file></action>
		<action><name>right</name><file>snd_cursor.wav</file></action>
		<action><name>up</name><file>snd_cursor.wav</file></action>
		<action><name>down</name><file>snd_cursor.wav</file></action>
		<action><name>pageup</name><file>snd_cursor.wav</file></action>
		<action><name>pagedown</name><file>snd_cursor.wav</file></action>
		<action><name>select</name><file>snd_decide.wav</file></action>
		<action><name>parentdir</name><file>snd_cancel.wav</file></action>
		<action><name>previousmenu</name><file>snd_cancel.wav</file></action>
		<action><name>back</name><file>snd_cancel.wav</file></action>
		<!-- the menu (c) and information (i), the psp's triangle -->
		<action><name>contextmenu</name><file>snd_option.wav</file></action>
		<action><name>info</name><file>snd_option.wav</file></action>
		<action><name>error</name><file>snd_error.wav</file></action>
	</actions>
	<windows>
		<window>
			<name>startup</name>
			<activate>snd_opening.wav</activate>
		</window>
		<window>
			<name>notification</name>
			<activate>snd_system_ok.wav</activate>
		</window>
		<window>
			<name>yesnodialog</name>
			<activate>snd_system_ng.wav</activate>
		</window>
		<window>
			<name>virtualkeyboard</name>
			<activate>snd_category_decide.wav</activate>
			<deactivate>snd_oskenter.wav</deactivate>
		</window>
	</windows>
</sounds>
