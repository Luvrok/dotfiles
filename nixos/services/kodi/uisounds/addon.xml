<?xml version="1.0" encoding="UTF-8"?>
<!-- the psp's menu sounds (home/local/media/soundeffect) as kodi's: settings
     -> interface -> skin -> navigation sounds. ../addons.nix copies the
     wavs in, ../defaults.py picks it the first time -->
<addon id="resource.uisounds.psp" version="1.0.0" name="PSP" provider-name="barnard">
	<requires>
		<import addon="kodi.resource" version="1.0.0"/>
	</requires>
	<extension point="kodi.resource.uisounds"/>
	<extension point="kodi.addon.metadata">
		<summary lang="en_GB">PSP UI sounds</summary>
		<description lang="en_GB">The sounds of the PSP's menu</description>
		<platform>all</platform>
	</extension>
</addon>
