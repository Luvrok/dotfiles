{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "small_model": "opencode/deepseek-v4.1-flash-free",
  "enabled_providers": [
    "opencode",
    "opencode-go",
    "llama-swap"
  ],
  "autoupdate": false,
  "_comment": "llama-swap: the local models, the same as pi/models.json (ids, contexts from modules/nixos/llama-swap/config.yaml)",
  "provider": {
    "llama-swap": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-swap (local)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1",
        "apiKey": "none"
      },
      "models": {
        "qwen": {
          "name": "Qwen3.8 27B",
          "tool_call": true,
          "limit": {
            "context": 131072,
            "output": 65536
          }
        },
        "qwen-uncensored": {
          "name": "Qwen3.8 27B uncensored",
          "tool_call": true,
          "limit": {
            "context": 131072,
            "output": 65536
          }
        },
        "qwen-uncensored-vision": {
          "name": "Qwen3.8 27B uncensored vision",
          "tool_call": true,
          "limit": {
            "context": 65536,
            "output": 24576
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "gemma-26b": {
          "name": "Gemma 4 26B-A4B",
          "tool_call": true,
          "limit": {
            "context": 131072,
            "output": 65536
          }
        },
        "gemma-12b": {
          "name": "Gemma 4 12B",
          "tool_call": true,
          "limit": {
            "context": 131072,
            "output": 65536
          }
        },
        "gpt-oss": {
          "name": "gpt-oss 20B",
          "tool_call": true,
          "limit": {
            "context": 131072,
            "output": 65536
          }
        }
      }
    }
  },
  "share": "disabled",
  "lsp": true,
  "formatter": true,
  "mcp": {
    "docs": {
      "type": "remote",
      "url": "http://127.0.0.1:6280/mcp",
      "enabled": true,
      "timeout": 120000
    },
    "notes": {
      "type": "remote",
      "url": "http://127.0.0.1:6281/mcp",
      "enabled": true,
      "timeout": 120000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "timeout": 30000
    },
    "searxng": {
      "type": "local",
      "command": [
        "mcp-searxng"
      ],
      "environment": {
        "SEARXNG_URL": "http://127.0.0.1:11433"
      },
      "enabled": true
    },
    "photocraft": {
      "type": "local",
      "command": [
        "photocraft-cli",
        "mcp",
        "--automation-read-root",
        "/home/barnard/HOME/wizzard/Holocron/9-files",
        "--automation-write-root",
        "/home/barnard/HOME/wizzard/Holocron/9-files"
      ],
      "enabled": true,
      "timeout": 120000
    },
    "vectorcraft": {
      "type": "local",
      "command": [
        "vectorcraft-cli",
        "mcp",
        "--automation-read-root",
        "/home/barnard/HOME/wizzard/Holocron/9-files",
        "--automation-write-root",
        "/home/barnard/HOME/wizzard/Holocron/9-files"
      ],
      "enabled": true,
      "timeout": 120000
    },
    "wordcraft": {
      "type": "local",
      "command": [
        "wordcraft-cli",
        "mcp",
        "--automation-read-root",
        "/home/barnard/HOME/wizzard/Holocron/9-files",
        "--automation-write-root",
        "/home/barnard/HOME/wizzard/Holocron/9-files"
      ],
      "enabled": true,
      "timeout": 120000
    },
    "gridcraft": {
      "type": "local",
      "command": [
        "gridcraft-cli",
        "mcp"
      ],
      "enabled": true,
      "timeout": 120000
    },
    "pdfcraft": {
      "type": "local",
      "command": [
        "pdfcraft-cli",
        "mcp",
        "--automation-read-root",
        "/home/barnard/HOME/wizzard/Holocron/9-files",
        "--automation-write-root",
        "/home/barnard/HOME/wizzard/Holocron/9-files"
      ],
      "enabled": true,
      "timeout": 120000
    },
    "deckcraft": {
      "type": "local",
      "command": [
        "deckcraft-cli",
        "mcp",
        "--automation-read-root",
        "/home/barnard/HOME/wizzard/Holocron/9-files",
        "--automation-write-root",
        "/home/barnard/HOME/wizzard/Holocron/9-files"
      ],
      "enabled": true,
      "timeout": 120000
    },
    "soundcraft": {
      "type": "local",
      "command": [
        "soundcraft-cli",
        "mcp",
        "--automation-read-root",
        "/home/barnard/HOME/wizzard/Holocron/9-files",
        "--automation-write-root",
        "/home/barnard/HOME/wizzard/Holocron/9-files"
      ],
      "enabled": true,
      "timeout": 120000
    },
    "effectcraft": {
      "type": "local",
      "command": [
        "effectcraft-cli",
        "mcp",
        "--automation-read-root",
        "/home/barnard/HOME/wizzard/Holocron/9-files",
        "--automation-write-root",
        "/home/barnard/HOME/wizzard/Holocron/9-files"
      ],
      "enabled": true,
      "timeout": 120000
    },
    "figcraft": {
      "type": "local",
      "command": [
        "figcraft-cli",
        "mcp",
        "--automation-read-root",
        "/home/barnard/HOME/wizzard/Holocron/9-files",
        "--automation-write-root",
        "/home/barnard/HOME/wizzard/Holocron/9-files"
      ],
      "enabled": true,
      "timeout": 120000
    },
    "filmcraft": {
      "type": "local",
      "command": [
        "filmcraft-cli",
        "mcp"
      ],
      "enabled": true,
      "timeout": 120000
    }
  },
  "permission": {
    "*": "allow",
    "docs_fetch_url": "deny",
    "notes_fetch_url": "deny",
    "websearch": "deny",
    "webfetch": "allow",
    "searxng_web_url_read": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.config/sops/**": "deny",
      "~/.config/sops-nix/**": "deny",
      "/run/secrets/**": "deny",
      "/run/secrets.d/**": "deny",
      "/run/user/*/secrets.d/**": "deny",
      "~/.netrc": "deny",
      "~/.config/gh/**": "deny",
      "~/.aws/**": "deny"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.config/sops/**": "deny",
      "~/.config/sops-nix/**": "deny",
      "/run/secrets/**": "deny",
      "/run/secrets.d/**": "deny",
      "/run/user/*/secrets.d/**": "deny",
      "~/.netrc": "deny",
      "~/.config/gh/**": "deny",
      "~/.aws/**": "deny",
      "~/.config/opencode/**": "deny",
      "/nix/store/**": "deny",
      ".git/**": "deny",
      "*/.git/**": "deny",
      "opencode.json": "deny",
      "opencode.jsonc": "deny",
      "*/opencode.json": "deny",
      "*/opencode.jsonc": "deny",
      ".opencode/**": "deny",
      "*/.opencode/**": "deny",
      "~/HOME/wizzard/Holocron/.obsidian/**": "deny",
      "~/HOME/wizzard/Holocron/.git/**": "deny"
    },
    "external_directory": {
      "*": "deny",
      "~/.config/opencode/**": "allow",
      "~/.local/share/opencode/**": "allow",
      "/nix/store/**": "allow",
      "~/HOME/wizzard/Holocron/**": "allow",
      "~/downloads/**": "allow"
    },
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "rm -r*": "deny",
      "rm -R*": "deny",
      "rm -f*": "deny",
      "rm --recursive*": "deny",
      "rm --force*": "deny",
      "rm * -r*": "deny",
      "rm * -R*": "deny",
      "rm * -f*": "deny",
      "rmdir *": "allow",
      "find * -delete*": "ask",
      "find * -exec*": "ask",
      "find * -ok*": "ask",
      "fd * -x*": "ask",
      "fd * -X*": "ask",
      "fd * --exec*": "ask",
      "shred *": "deny",
      "truncate *": "ask",
      "sudo *": "deny",
      "doas *": "deny",
      "su *": "deny",
      "pkexec *": "deny",
      "dd *": "deny",
      "mkfs*": "deny",
      "wipefs *": "deny",
      "fdisk *": "deny",
      "parted *": "deny",
      "mount *": "deny",
      "umount *": "deny",
      "chmod -R*": "deny",
      "chown *": "deny",
      "chgrp *": "deny",
      "reboot*": "deny",
      "shutdown*": "deny",
      "poweroff*": "deny",
      "halt*": "deny",
      "systemctl *": "ask",
      "systemctl status *": "allow",
      "systemctl list-*": "allow",
      "systemctl is-*": "allow",
      "systemctl show *": "allow",
      "systemctl cat *": "allow",
      "systemctl --user status *": "allow",
      "systemctl --user list-*": "allow",
      "systemctl --user is-*": "allow",
      "systemctl --user show *": "allow",
      "systemctl --user cat *": "allow",
      "kill *": "ask",
      "pkill *": "ask",
      "killall *": "ask",
      "nixos-rebuild*": "deny",
      "nh *": "deny",
      "nix flake update*": "deny",
      "nix flake lock*": "ask",
      "nix-collect-garbage*": "deny",
      "nix store gc*": "deny",
      "nix-store --gc*": "deny",
      "nix profile *": "ask",
      "* | sh*": "deny",
      "* | bash*": "deny",
      "* | zsh*": "deny",
      "* | sudo*": "deny",
      "git push*": "ask",
      "git push* -f*": "deny",
      "git push* --force*": "deny",
      "git reset --hard*": "ask",
      "git clean*": "ask",
      "git checkout -- *": "ask",
      "git restore*": "ask",
      "git restore --staged*": "allow",
      "git restore *--worktree*": "deny",
      "git restore *-W*": "deny",
      "git restore *-?W*": "deny",
      "git restore *-??W*": "deny",
      "git rebase*": "ask",
      "git branch -D*": "ask",
      "git stash drop*": "ask",
      "git stash clear*": "ask",
      "git * --output*": "ask",
      "git * --ext-diff*": "ask",
      "git * --textconv*": "ask",
      "* *.env": "ask",
      "* *.env.*": "ask",
      "* *.env.example": "allow",
      "rg * --pre*": "ask"
    }
  }
}
