# "save as" through the file chooser portal (termfilechooser here), prints
# the path that was picked, exits 1 when it was cancelled
#   hypr-savefile <name> [folder] [title]
import secrets
import sys
from urllib.parse import unquote, urlparse

from jeepney import DBusAddress, MatchRule, message_bus, new_method_call
from jeepney.io.blocking import Proxy, open_dbus_connection

name = sys.argv[1]
folder = sys.argv[2] if len(sys.argv) > 2 else ""
title = sys.argv[3] if len(sys.argv) > 3 else "save"

conn = open_dbus_connection(bus="SESSION")
# the portal answers on a request object named after us and the token,
# listen there before asking so the answer can't come first
token = "hypr" + secrets.token_hex(4)
sender = conn.unique_name[1:].replace(".", "_")
handle = f"/org/freedesktop/portal/desktop/request/{sender}/{token}"
rule = MatchRule(
    type="signal",
    interface="org.freedesktop.portal.Request",
    member="Response",
    path=handle,
)
Proxy(message_bus, conn).AddMatch(rule)

options = {
    "handle_token": ("s", token),
    "current_name": ("s", name),
}
if folder:
    options["current_folder"] = ("ay", folder.encode() + b"\0")
portal = DBusAddress(
    "/org/freedesktop/portal/desktop",
    bus_name="org.freedesktop.portal.Desktop",
    interface="org.freedesktop.portal.FileChooser",
)
with conn.filter(rule) as answers:
    conn.send_and_get_reply(
        new_method_call(portal, "SaveFile", "ssa{sv}", ("", title, options))
    )
    code, results = conn.recv_until_filtered(answers).body

uris = results.get("uris", ("as", []))[1]
if code != 0 or not uris:
    sys.exit(1)
print(unquote(urlparse(uris[0]).path))
