#!/usr/bin/env bash
# one still for the picker's preview, cached with the other previews and
# remade only when the source is newer. a video is sampled a second in (not
# the black first frame); a picture is its own only frame, so no seek
#   wall-thumb <file> <out.jpg>
set -euo pipefail

src=${1:-}
out=${2:-}
if [[ ! -f ${src} || -z ${out} ]]; then
  exit 0
fi
if [[ -s ${out} && ${out} -nt ${src} ]]; then
  exit 0
fi

mkdir -p "$(dirname "${out}")"
seek=(-ss 1)
case ${src,,} in
  *.jpg|*.jpeg|*.png|*.webp|*.avif|*.bmp)
    seek=()
    ;;
esac
ffmpeg -nostdin -loglevel error -y "${seek[@]}" -i "${src}" -frames:v 1 -vf 'scale=480:-2' -q:v 4 -f image2 "${out}.tmp" 2>/dev/null \
  || ffmpeg -nostdin -loglevel error -y -i "${src}" -frames:v 1 -vf 'scale=480:-2' -q:v 4 -f image2 "${out}.tmp" 2>/dev/null \
  || true
if [[ -s ${out}.tmp ]]; then
  mv -f "${out}.tmp" "${out}"
else
  rm -f "${out}.tmp"
  exit 1
fi
