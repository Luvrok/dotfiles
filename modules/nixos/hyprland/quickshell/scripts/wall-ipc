# send one command to the mpv that mpvpaper runs (its input-ipc-server)
#   wall-ipc <socket> <command...>
# used for pausing the wallpaper instead of killing it, Wallpaper.qml
import socket
import sys

if len(sys.argv) < 3:
    sys.exit(2)

try:
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.settimeout(2)
    sock.connect(sys.argv[1])
    sock.sendall((" ".join(sys.argv[2:]) + "\n").encode())
    sock.close()
except OSError:
    sys.exit(1)
