+def translate_tokenized_batch(
+    pkg: Package, translator: Translator, tokenized: list[list[str]]
+) -> list[list[str]]:
+    """Translates tokenized sentences with one CTranslate2 call.
+
+    CTranslate2 splits them into sub-batches of up to ARGOS_BATCH_SIZE tokens
+    and spreads those over its ARGOS_INTER_THREADS workers.
+
+    Returns:
+        The tokens of the best hypothesis for every sentence.
+    """
+    if len(tokenized) == 0:
+        return []
+    target_prefix = None
+    if pkg.target_prefix != "":
+        target_prefix = [[pkg.target_prefix]] * len(tokenized)
+    translated_batches = translator.translate_batch(
+        tokenized,
+        target_prefix=target_prefix,
+        replace_unknowns=True,
+        max_batch_size=settings.batch_size,
+        batch_type="tokens",
+        beam_size=settings.beam_size,
+        num_hypotheses=1,
+        length_penalty=0.2,
+    )
+    return [translated_batch.hypotheses[0] for translated_batch in translated_batches]
+
+
+def decode_translation(pkg: Package, translated_tokens: list[str]) -> str:
+    """Turns translated tokens into text, as apply_packaged_translation does."""
+    value = pkg.tokenizer.decode(translated_tokens)
+    if pkg.target_prefix != "" and value.startswith(pkg.target_prefix):
+        value = value[len(pkg.target_prefix) :]
+    if len(value) > 0 and value[0] == " ":
+        value = value[1:]
+    return value
+
