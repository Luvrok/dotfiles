;; keybind cheat sheet, pages come from keys.conf, keys from the i3 "keys" mode
;; state is pushed by the keys-menu script

(defvar keys_reveal false)
(defvar keys_rows false)
(defvar keys_page '{"cols": [], "tabs": []}')

;; overlay, never takes focus. under the bar on the right, 8px off the edge
;; like the gap under the bar (x adds to the anchor, so it's negative)
(defwindow keys-menu
  :monitor 0
  :geometry (geometry :x "-8px" :y "32px" :anchor "top right")
  :stacking "overlay"
  :wm-ignore true
  (revealer
    :reveal keys_reveal
    :transition "slidedown"
    :duration "180ms"
    :valign "start"
    (box :class "keys" :orientation "v" :space-evenly false
      (box :class "keys-head" :space-evenly false
        (label :class "keys-title" :halign "start" :hexpand true :text "keys")
        ;; pages like tags in the bar, orange is the open one
        (box :space-evenly false
          (for t in {keys_page.tabs}
            (label :class "keys-tab ${t.sel ? 'sel' : ''}" :text {t.name}))))
      (box :space-evenly false
        ;; columns take the spare width, the window keeps the size of a bigger page
        (for col in {keys_page.cols}
          (box :class "keys-col" :orientation "v" :space-evenly false :hexpand true
            (for sec in col
              ;; each section has its own revealer, later ones take longer = cascade
              (revealer
                :reveal keys_rows
                :transition "slidedown"
                :duration "${120 + sec.i * 60}ms"
                (box :class "keys-sec" :orientation "v" :space-evenly false
                  (label :class "keys-sec-title" :halign "start" :visible {sec.name != ""} :text {sec.name})
                  (for row in {sec.rows}
                    (box :class "keys-row" :space-evenly false
                      (label :class "keys-what" :halign "start" :hexpand true :text {row.what})
                      (box :space-evenly false :valign "center"
                        (for k in {row.keys}
                          (label :class "keys-${k.c}" :text {k.t})))))))))))
      (label :class "keys-hint" :halign "start" :text "h/l page  esc  any other key or click closes"))))
