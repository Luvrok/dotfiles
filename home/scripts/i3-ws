# dwm-like tags: every monitor has its own 1..9, windows move between
# monitors, workspaces don't. primary is 1..9, the next ones left to right
# 11..19, 21..29, same order as eww-i3-workspaces.
#   i3-ws N         show tag N on this monitor
#   i3-ws move N    move the window to tag N of this monitor
#   i3-ws follow N  move the window and go with it
#   i3-ws back      previous tag of this monitor

# i3 makes a new socket on restart, the env still has the old one
unset I3SOCK

# focused monitor, current workspace and the tag offset of this monitor
read -r out cur off < <(jq -rn \
  --argjson ws "$(i3-msg -t get_workspaces)" \
  --argjson outs "$(i3-msg -t get_outputs)" '
  ($ws[] | select(.focused)) as $f
  | [ $outs[] | select(.active) ] | sort_by([(.primary | not), .rect.x]) | map(.name)
  | "\($f.output) \($f.num) \(index($f.output) * 10)"')

# per monitor, i3's back_and_forth is global
prev_file=${XDG_RUNTIME_DIR:-/tmp}/i3-ws-$out

# i3-ws-anim tags windows so picom drifts them the right way.
# $2 is an i3 command to run instead of the plain switch
view() {
  if [ "$1" != "$cur" ]; then
    printf '%s\n' "$cur" >"$prev_file"
    i3-ws-anim "$1" "${2:-workspace number $1}"
  fi
}

case ${1:-} in
  move)
    # through i3-ws-anim too, the window drifts toward its new tag
    t=$((off + $2))
    i3-ws-anim "$t" "move container to workspace number $t"
    ;;
  follow)
    # one call, so the window doesn't hide in between
    t=$((off + $2))
    view "$t" "move container to workspace number $t, workspace number $t"
    ;;
  back)
    prev=$(cat "$prev_file" 2>/dev/null) || exit 0
    # may be left from another monitor layout
    if [ "$prev" -gt "$off" ] && [ "$prev" -le "$((off + 9))" ]; then
      view "$prev"
    fi
    ;;
  *)
    view "$((off + $1))"
    ;;
esac
