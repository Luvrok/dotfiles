# switch workspace with a direction hint for picom.
# i3 numbers ewmh desktops by position, so when empty workspaces come and go
# the index often stays the same and picom plays hide/show instead of the
# drift. so windows on both workspaces get _WS_SWITCH (1 going up, 2 going
# down) and picom rules pick the drift for them.
#
# usage:
#   i3-ws-anim <target>              same as: i3-msg workspace number <target>
#   i3-ws-anim <target> <i3 cmd>     run your own command, e.g. move + switch

# picom.nix writes it, slow mode included
untag_delay=$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/picom/ws-untag" 2>/dev/null || echo 0.3)

target=$1
shift
cmd=${*:-"workspace number $target"}

# focused workspace + windows on it and on the target, one i3 call
read -r cur ids < <(i3-msg -t get_tree | jq -r --arg t "$target" '
  [.. | objects | select(.type == "workspace")] as $ws
  | (first($ws[] | select(any(.. | objects; .focused == true))) | .name) as $cur
  | [$ws[] | select(.name == $cur or .name == $t)
     | .. | objects | select(.window) | .window | tostring] as $ids
  | "\($cur) \($ids | join(" "))"')

# not numbers or the same workspace: no hint
if [[ ! $cur =~ ^[0-9]+$ || ! $target =~ ^[0-9]+$ || $cur == "$target" ]]; then
  exec i3-msg -q "$cmd"
fi

if ((target > cur)); then dir=1; else dir=2; fi

state=${XDG_RUNTIME_DIR:-/tmp}/i3-ws-anim
# the untag below must not wipe tags of a switch that starts meanwhile
exec 9>"$state.lock"
flock 9
gen=$(date +%s%N)
echo "$gen" >"$state.gen"
for id in $ids; do echo "$id"; done >>"$state.ids"

# in parallel, it's on the hot path
for id in $ids; do
  xprop -id "$id" -f _WS_SWITCH 32c -set _WS_SWITCH "$dir" &
done
wait
flock -u 9
# picom re-reads rules of mapped windows on its next frame, give it one
# before i3 unmaps the current workspace
sleep 0.02

i3-msg -q "$cmd"

# untag after the anim, unless a newer switch happened meanwhile
(
  sleep "$untag_delay"
  flock 9
  [[ $(cat "$state.gen" 2>/dev/null) == "$gen" ]] || exit 0
  sort -u "$state.ids" | {
    while read -r id; do
      xprop -id "$id" -remove _WS_SWITCH 2>/dev/null &
    done
    wait
  }
  : >"$state.ids"
) &
