{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "small_model": "opencode/deepseek-v4.1-flash-free",
  "enabled_providers": [
    "opencode",
    "google",
    "groq",
    "nvidia",
    "openrouter",
    "cerebras",
    "mistral",
    "zai",
    "github-copilot",
    "llama-swap"
  ],
  "autoupdate": false,

  "_comment": "llama-swap: the local models, the same as pi/models.json (ids, contexts from nixos/services/llama-swap/config.yaml)",
  "provider": {
    "llama-swap": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-swap (local)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1",
        "apiKey": "none"
      },
      "models": {
        "qwen": {
          "name": "Qwen3.8 27B",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 131072,
            "output": 65536
          }
        },
        "qwen-uncensored": {
          "name": "Qwen3.8 27B uncensored",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 131072,
            "output": 65536
          }
        },
        "qwen-uncensored-vision": {
          "name": "Qwen3.8 27B uncensored vision",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 65536,
            "output": 24576
          },
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "gemma-26b": {
          "name": "Gemma 4 26B-A4B",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 131072,
            "output": 65536
          }
        },
        "gemma-12b": {
          "name": "Gemma 4 12B",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 131072,
            "output": 65536
          }
        },
        "gpt-oss": {
          "name": "gpt-oss 20B",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 131072,
            "output": 65536
          }
        }
      }
    }
  },

  "share": "disabled",
  "lsp": true,
  "formatter": true,

  "mcp": {
    "docs": {
      "type": "remote",
      "url": "http://127.0.0.1:6280/mcp",
      "enabled": true,
      "timeout": 120000
    },
    "notes": {
      "type": "remote",
      "url": "http://127.0.0.1:6281/mcp",
      "enabled": true,
      "timeout": 120000
    },
    "searxng": {
      "type": "local",
      "command": ["mcp-searxng"],
      "environment": {
        "SEARXNG_URL": "http://127.0.0.1:11433"
      },
      "enabled": true
    }
  },

  "permission": {
    "*": "allow",

    "docs_fetch_url": "deny",
    "notes_fetch_url": "deny",
    "websearch": "deny",
    "webfetch": "ask",
    "searxng_web_url_read": "ask",

    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.config/sops/**": "deny",
      "~/.config/sops-nix/**": "deny",
      "/run/secrets/**": "deny",
      "/run/secrets.d/**": "deny",
      "/run/user/*/secrets.d/**": "deny",
      "~/.netrc": "deny",
      "~/.config/gh/**": "deny",
      "~/.aws/**": "deny"
    },

    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.config/sops/**": "deny",
      "~/.config/sops-nix/**": "deny",
      "/run/secrets/**": "deny",
      "/run/secrets.d/**": "deny",
      "/run/user/*/secrets.d/**": "deny",
      "~/.netrc": "deny",
      "~/.config/gh/**": "deny",
      "~/.aws/**": "deny",
      "~/.config/opencode/**": "deny",
      "/nix/store/**": "deny",
      ".git/**": "deny",
      "*/.git/**": "deny",
      "opencode.json": "deny",
      "opencode.jsonc": "deny",
      "*/opencode.json": "deny",
      "*/opencode.jsonc": "deny",
      ".opencode/**": "deny",
      "*/.opencode/**": "deny"
    },

    "external_directory": {
      "*": "deny",
      "~/.config/opencode/**": "allow",
      "~/.local/share/opencode/**": "allow",
      "/nix/store/**": "allow"
    },

    "bash": {
      "*": "ask",

      "cd *": "allow",
      "pwd": "allow",
      "echo *": "allow",
      "which *": "allow",
      "type *": "allow",
      "date": "allow",
      "uname *": "allow",
      "ps *": "allow",

      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "ls *": "allow",
      "tree *": "allow",
      "stat *": "allow",
      "file *": "allow",
      "wc *": "allow",
      "du *": "allow",
      "df *": "allow",

      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "find * -delete*": "ask",
      "fd *": "allow",

      "sort *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "jq *": "allow",
      "diff *": "allow",
      "sha256sum *": "allow",

      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git blame *": "allow",
      "git ls-files *": "allow",
      "git rev-parse *": "allow",
      "git branch": "allow",
      "git remote -v": "allow",

      "* > *": "ask",
      "* >> *": "ask",
      "* *.env": "ask",
      "* *.env.*": "ask",
      "find * -exec*": "ask",
      "find * -ok*": "ask",
      "find * -fprint*": "ask",
      "find * -fls*": "ask",
      "fd * -x*": "ask",
      "fd * -X*": "ask",
      "fd * --exec*": "ask",
      "rg * --pre*": "ask",
      "sort * -o*": "ask",
      "sort * --output*": "ask",
      "tree * -o*": "ask",
      "git * --output*": "ask",
      "git * --ext-diff*": "ask",
      "git * --textconv*": "ask"
    }
  }
}
